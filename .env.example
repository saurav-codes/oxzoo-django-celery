# Read at run time by the Celery worker and baked into the SPA at build time (envPrefix).
GREETING_TAG=change-me
# Django's signing key: press Generate on the review screen, or pass ox review --generate SECRET_KEY.
SECRET_KEY=
# DATABASE_URL and REDIS_URL are provided by ox from [services] in ox.toml.

# Scenario probes (no-ops when unset); see the README. Not needed for a normal deploy.
# MIGRATION_LOCK_SECONDS=20
# DESTRUCTIVE_MIGRATION=drop
