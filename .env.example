GREETING_TAG=change-me
SECRET_KEY=change-me-secret-key
# DATABASE_URL's placeholder makes ox provision local postgres and inject the
# full DSN; DATABASE_NAME names the database it creates, and it must match the
# [[postgres_databases]] name in ox.toml so the extension step (pgcrypto)
# targets the same database.
DATABASE_URL=postgres://change-me
DATABASE_NAME=oxzoo-celery
REDIS_URL=redis://change-me
