GREETING_TAG=change-me
# SECRET_KEY / DATABASE_URL / REDIS_URL use ox's REPLACE_ME convention:
# values containing REPLACE_ME are regenerated by ox's env autowiring, and
# the postgres:// and redis:// schemes signal local PostgreSQL and Redis
# provisioning. DATABASE_NAME names the database ox creates; it must match
# the [[postgres_databases]] name in ox.toml so the pgcrypto extension step
# targets the same database. Paste these values into the ox env editor.
SECRET_KEY=REPLACE_ME
DATABASE_URL=postgres://REPLACE_ME
DATABASE_NAME=oxzoo-celery
REDIS_URL=redis://REPLACE_ME

# Scenario probes (no-ops when unset); see the README. Not needed for a normal deploy.
# MIGRATION_LOCK_SECONDS=20
# DESTRUCTIVE_MIGRATION=drop
